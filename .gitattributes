* text=auto eol=lf
# Windows launchers must be CRLF and pure ASCII: cmd.exe mangles a batch file
# that mixes non-ASCII content with LF-only line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
# ...and the macOS launcher must stay LF: a CR before the shebang's newline
# makes Terminal fail with "bad interpreter". It also needs its executable bit.
*.command text eol=lf
